# ─────────────────────────────────────────────────────────────
# FRONTEND — Firebase client SDK
# Estos valores van al bundle del browser. Es seguro commitearlos
# porque la seguridad real la hacen las Firestore Security Rules.
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─────────────────────────────────────────────────────────────
# VERCEL API (server-side) — Firebase Admin SDK
# NUNCA agregar prefijo VITE_ a estas variables.
# Se configuran en el dashboard de Vercel, no en .env.local.
# ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────────────────────
# VERCEL API (server-side) — Google Cloud Run
# URL interna del solver. Nunca exponer al frontend.
# ─────────────────────────────────────────────────────────────
CLOUD_RUN_SOLVER_URL=https://shiftboard-solver-xxxxxxxx-uc.a.run.app
