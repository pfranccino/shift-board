rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────

    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    function isMember(orgId) {
      return exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId));
    }

    function memberRole(orgId) {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)).data.role;
    }

    function isOwnerOrAdmin(orgId) {
      return memberRole(orgId) in ['owner', 'admin'];
    }

    // ── Superadmins (read-only from client, written via Firebase console) ─

    match /superadmins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ── Memberships ───────────────────────────────────────────────────────

    match /memberships/{membershipId} {
      allow read: if request.auth != null &&
        (membershipId.split('_')[0] == request.auth.uid ||
         isOwnerOrAdmin(membershipId.split('_')[1]));
      // Superadmins can create any membership.
      // Regular users can create their own (invitation acceptance).
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        isSuperAdmin() || isOwnerOrAdmin(resource.data.orgId)
      );
    }

    // ── Invitations ───────────────────────────────────────────────────────

    match /invitations/{token} {
      allow read: if true; // Public so invited users can fetch by token
      allow create: if request.auth != null && (
        isSuperAdmin() || isOwnerOrAdmin(request.resource.data.orgId)
      );
      allow update: if false;
      allow delete: if request.auth != null && (
        isSuperAdmin() || isOwnerOrAdmin(resource.data.orgId)
      );
    }

    // ── Organizations ─────────────────────────────────────────────────────

    match /organizations/{orgId} {
      // Only superadmins can create new organizations
      allow create: if request.auth != null && isSuperAdmin();
      allow read, update, delete: if request.auth != null && isMember(orgId);

      // Workers
      match /workers/{workerId} {
        allow read: if request.auth != null && isMember(orgId);
        allow write: if request.auth != null && isMember(orgId);
      }

      // Members sub-collection
      match /members/{memberId} {
        allow read: if request.auth != null && isMember(orgId);
        // Superadmins or the user creating their own member doc (invitation acceptance)
        allow create: if request.auth != null && (
          isSuperAdmin() || memberId == request.auth.uid
        );
        allow update, delete: if request.auth != null && (
          isSuperAdmin() || isOwnerOrAdmin(orgId)
        );
      }

      // Config
      match /config/{configId} {
        allow read: if request.auth != null && isMember(orgId);
        allow write: if request.auth != null && isOwnerOrAdmin(orgId);
      }

      // Schedules
      match /schedules/{weekKey}/assignments/{workerId} {
        allow read: if request.auth != null && isMember(orgId);
        allow write: if request.auth != null && isMember(orgId);
      }

      // Solver jobs — members can read, only server SDK writes
      match /jobs/{jobId} {
        allow read: if request.auth != null && isMember(orgId);
        allow create: if false;
        allow update: if false;
      }
    }
  }
}
