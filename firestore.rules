rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────

    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    function isMember(orgId) {
      return exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId));
    }

    function memberRole(orgId) {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)).data.role;
    }

    function isOwnerOrAdmin(orgId) {
      return memberRole(orgId) in ['owner', 'admin'];
    }

    // ── Superadmins (read-only from client, written via Firebase console) ─

    match /superadmins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ── Memberships ───────────────────────────────────────────────────────

    match /memberships/{membershipId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        isOwnerOrAdmin(resource.data.orgId)
      );
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        isSuperAdmin() || isOwnerOrAdmin(resource.data.orgId)
      );
    }

    // ── Invitations ───────────────────────────────────────────────────────

    match /invitations/{token} {
      allow read: if true;
      allow create: if request.auth != null && (
        isSuperAdmin() || isOwnerOrAdmin(request.resource.data.orgId)
      );
      allow update: if false;
      allow delete: if request.auth != null && (
        isSuperAdmin() || isOwnerOrAdmin(resource.data.orgId)
      );
    }

    // ── Organizations ─────────────────────────────────────────────────────

    match /organizations/{orgId} {
      // Any authenticated user can create their own org (signup flow)
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (isSuperAdmin() || isMember(orgId));

      // Workers
      match /workers/{workerId} {
        allow read: if request.auth != null && (isSuperAdmin() || isMember(orgId));
        allow write: if request.auth != null && (isSuperAdmin() || isMember(orgId));
      }

      // Members sub-collection
      match /members/{memberId} {
        allow read: if request.auth != null && (isSuperAdmin() || isMember(orgId));
        allow create: if request.auth != null && (
          isSuperAdmin() || memberId == request.auth.uid
        );
        allow update, delete: if request.auth != null && (
          isSuperAdmin() || isOwnerOrAdmin(orgId)
        );
      }

      // Config
      match /config/{configId} {
        allow read: if request.auth != null && (isSuperAdmin() || isMember(orgId));
        allow write: if request.auth != null && (isSuperAdmin() || isOwnerOrAdmin(orgId));
      }

      // Schedules
      match /schedules/{weekKey}/assignments/{workerId} {
        allow read: if request.auth != null && (isSuperAdmin() || isMember(orgId));
        allow write: if request.auth != null && (isSuperAdmin() || isMember(orgId));
      }

      // Solver jobs — members can read, only server SDK writes
      match /jobs/{jobId} {
        allow read: if request.auth != null && (isSuperAdmin() || isMember(orgId));
        allow create: if false;
        allow update: if false;
      }
    }
  }
}
