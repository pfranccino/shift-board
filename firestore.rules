rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────

    function isMember(orgId) {
      return exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId));
    }

    function memberRole(orgId) {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)).data.role;
    }

    function isOwnerOrAdmin(orgId) {
      return memberRole(orgId) in ['owner', 'admin'];
    }

    // ── Memberships ───────────────────────────────────────────────────────

    match /memberships/{membershipId} {
      allow read: if request.auth != null &&
        (membershipId.split('_')[0] == request.auth.uid ||
         isOwnerOrAdmin(membershipId.split('_')[1]));
      // Users can create their own owner membership when creating a new org
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.role == 'owner';
      allow delete: if request.auth != null && isOwnerOrAdmin(resource.data.orgId);
    }

    // ── Invitations ───────────────────────────────────────────────────────

    match /invitations/{token} {
      allow read: if true; // Public so invited users can fetch their invite by token
      allow create: if request.auth != null && isOwnerOrAdmin(request.resource.data.org_id);
      allow update: if false; // Marked as used server-side only
      allow delete: if request.auth != null && isOwnerOrAdmin(resource.data.org_id);
    }

    // ── Organizations ─────────────────────────────────────────────────────

    match /organizations/{orgId} {
      // Any authenticated user can create a new org
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && isMember(orgId);

      // Workers
      match /workers/{workerId} {
        allow read: if request.auth != null && isMember(orgId);
        allow write: if request.auth != null && isMember(orgId);
      }

      // Members sub-collection
      match /members/{memberId} {
        allow read: if request.auth != null && isMember(orgId);
        // User can create their own member document during org creation (before membership exists)
        allow create: if request.auth != null &&
          (memberId == request.auth.uid || isOwnerOrAdmin(orgId));
        allow update, delete: if request.auth != null && isOwnerOrAdmin(orgId);
      }

      // Config (shift types, categories, coverage, solver settings)
      match /config/{configId} {
        allow read: if request.auth != null && isMember(orgId);
        allow write: if request.auth != null && isOwnerOrAdmin(orgId);
      }

      // Schedules (assignments per week)
      match /schedules/{weekKey}/assignments/{workerId} {
        allow read: if request.auth != null && isMember(orgId);
        allow write: if request.auth != null && isMember(orgId);
      }

      // Solver jobs — members can read, only server SDK writes
      match /jobs/{jobId} {
        allow read: if request.auth != null && isMember(orgId);
        allow create: if false; // Created by Vercel API only
        allow update: if false; // Updated by Cloud Run only
      }
    }
  }
}
